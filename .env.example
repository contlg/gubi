# Kakao Developers > 내 애플리케이션 > 앱 키
# REST API 키 — 서버 전용 (로컬 검색, Mobility 길찾기)
KAKAO_REST_API_KEY=

# JavaScript 키 — 지도 표시용 (브라우저 노출됨, 도메인 제한 설정 권장)
NEXT_PUBLIC_KAKAO_JS_KEY=

# ── 소셜 로그인 (웹) ─────────────────────────────────────────────
# 카카오: 콘솔 > 카카오 로그인 활성화 ON,
#   Redirect URI 등록: https://drivelog.homesev.duckdns.org/api/auth/oauth/kakao/callback
#   (+ 로컬 테스트용 http://localhost:1006/api/auth/oauth/kakao/callback), 동의항목=닉네임.
# 로그인은 "리다이렉트 URI·시크릿을 등록한 앱"의 REST 키를 client_id로 써야 한다.
#   그 앱이 지도/길찾기용 KAKAO_REST_API_KEY와 같은 앱이면 아래는 비워도 되고(폴백),
#   다른 앱이면 그 앱의 REST 키를 여기에 넣는다. (client_id ↔ redirect_uri 앱 불일치 = KOE006)
KAKAO_OAUTH_CLIENT_ID=
# "Client Secret"을 콘솔에서 켰다면 넣는다(위 로그인 앱 기준).
KAKAO_CLIENT_SECRET=

# 구글: Google Cloud Console > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID(웹 애플리케이션).
#   승인된 리디렉션 URI 등록: https://drivelog.homesev.duckdns.org/api/auth/oauth/google/callback
#   (+ http://localhost:1006/api/auth/oauth/google/callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
